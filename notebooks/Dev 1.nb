Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{"swapRule", "=", 
    RowBox[{
     RowBox[{"expr1_", "**", "expr2_"}], ":>", 
     RowBox[{
      RowBox[{"expr2", "**", "expr1"}], "/;", 
      RowBox[{"With", "[", 
       RowBox[{"(*", 
        RowBox[{"First", ",", 
         RowBox[{
         "get", " ", "a", " ", "list", " ", "of", " ", "all", " ", "unique", " ",
           "noncommutative", " ", "symbols"}]}], "*)"}], 
       RowBox[{"(*", 
        RowBox[{"within", " ", "the", " ", "matched", " ", 
         RowBox[{"expression", "'"}], 
         RowBox[{"expr1", "**", 
          RowBox[{"expr2", "'"}]}]}], "*)"}], 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"symbols", "=", 
          RowBox[{"Union", "[", 
           RowBox[{"Cases", "[", 
            RowBox[{
             RowBox[{"expr1", "**", "expr2"}], ",", 
             RowBox[{"_Symbol", "?", "NonCommutativeQ"}], ",", "Infinity"}], 
            "]"}], "]"}]}], "}"}], ",", 
        RowBox[{"(*", 
         RowBox[{
         "The", " ", "rule", " ", "applies", " ", "ONLY", " ", "IF", " ", 
          "the", " ", "condition", " ", "below", " ", "is", " ", 
          RowBox[{"True", "."}]}], "*)"}], 
        RowBox[{"(*", 
         RowBox[{
         "We", " ", "check", " ", "if", " ", "it", " ", "is", " ", "NOT", " ",
           "the", " ", "case", " ", "that", " ", "all", " ", "symbols", " ", 
          "commute", " ", "with", " ", "each", " ", 
          RowBox[{"other", "."}]}], "*)"}], 
        RowBox[{"!", 
         RowBox[{"DoAllElementsCommute", "[", 
          RowBox[{"symbols", ",", "symbols"}], "]"}]}]}], "]"}]}]}]}], ";"}], 
  "*)"}]], "Input",
 CellChangeTimes->{{3.960829139809471*^9, 3.9608291649144726`*^9}, {
   3.960829342888426*^9, 3.9608293815758553`*^9}, 3.9608296924547863`*^9},
 CellLabel->"In[15]:=",ExpressionUUID->"dc8c4e87-ff5d-0d4b-af0c-e1f26628be53"],

