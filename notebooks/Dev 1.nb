Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "for", " ", "two", " ", "lists", " ", "list1", " ", "and", " ", "list2", " ",
      "of", " ", "noncommutative", " ", "symbols"}], ",", 
    RowBox[{
    "check", " ", "whether", " ", "atleast", " ", "one", " ", "element", " ", 
     "of", " ", "list1", " ", "not", " ", "commute", " ", "with", " ", 
     "list2", " ", "then", " ", "return", " ", 
     RowBox[{"false", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"DoAllElementsCommute", "[", 
      RowBox[{"l1_", ",", "l2_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "nonCommutingPairs", "}"}], ",", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
         "Return", " ", "True", " ", "if", " ", "either", " ", "list", " ", 
          "is", " ", "empty"}], ",", 
         RowBox[{"as", " ", 
          RowBox[{"there", "'"}], "s", " ", "nothing", " ", "to", " ", "not", 
          " ", "commute", " ", "with"}]}], "*)"}], 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"l1", "===", 
            RowBox[{"{", "}"}]}], "||", 
           RowBox[{"l2", "===", 
            RowBox[{"{", "}"}]}]}], ",", 
          RowBox[{"Return", "[", "True", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"Generate", " ", "all", " ", "commutators"}], ",", 
          RowBox[{"e", ".", "g", "."}], ",", 
          RowBox[{
           RowBox[{"a", "**", "b"}], "-", 
           RowBox[{"b", "**", "a"}]}]}], "*)"}], 
        RowBox[{"nonCommutingPairs", "=", 
         RowBox[{"Flatten", "[", 
          RowBox[{"Outer", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"#1", "**", "#2"}], "-", 
              RowBox[{"#2", "**", "#1"}]}], "&"}], ",", "l1", ",", "l2"}], 
           "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{
          "If", " ", "any", " ", "commutator", " ", "is", " ", "not", " ", 
           "possibly", " ", "zero"}], ",", 
          RowBox[{
          "the", " ", "lists", " ", "do", " ", "not", " ", "fully", " ", 
           "commute"}]}], "*)"}], 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"MemberQ", "[", 
           RowBox[{"nonCommutingPairs", ",", 
            RowBox[{"_", "?", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"!", 
                RowBox[{"PossibleZeroQ", "[", "#", "]"}]}], "&"}], ")"}]}]}], 
           "]"}], ",", "False", ",", "True"}], "]"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]"}]}]], "Input",
