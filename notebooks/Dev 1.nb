Cell[BoxData[
 RowBox[{"(*", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "a", " ", "function", " ", "in", " ", "mathematica", " ", "ncalgebra", " ",
     "such", " ", "that", " ", "if", " ", "an", " ", "expression", " ", "is", 
    " ", "in", " ", "the", " ", "form", " ", "of", " ", 
    RowBox[{
    "expr1", "**", "expr2", "**", "expr3", "**", "expr4", "**", "expr5"}], " ",
     "then", " ", "it", " ", "will", " ", "read", " ", "from", " ", "the", " ",
     "first", " ", "term", " ", "expr1", " ", "and", " ", "swap", " ", 
    RowBox[{"expr1", "**", "expr2"}], " ", "to", " ", 
    RowBox[{"expr2", "**", "expr1"}], " ", "if", " ", "expr1", " ", "and", " ",
     "expr2", " ", "is", " ", "commutative", " ", "and", " ", "will", " ", 
    "continue", " ", "to", " ", "do", " ", "it", " ", "untill", " ", "the", " ",
     "term", " ", "becomes", " ", "commutative", " ", 
    RowBox[{"part", "**", "noncommutative"}], " ", "part"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"CommutativeSort", "[", "expr_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "rule", "}"}], ",", 
     RowBox[{
      RowBox[{"rule", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"h_", "**", "t___"}], ")"}], ":>", 
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"first", "=", "h"}], ",", 
            RowBox[{"second", "=", 
             RowBox[{"First", "[", 
              RowBox[{"{", "t", "}"}], "]"}]}]}], "}"}], ",", 
          RowBox[{
           RowBox[{"second", "**", "first", "**", 
            RowBox[{"Drop", "[", 
             RowBox[{
              RowBox[{"{", "t", "}"}], ",", "1"}], "]"}]}], "/;", 
           RowBox[{"CommutativeSort", "[", 
            RowBox[{"first", ",", "second"}], "]"}]}]}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"FixedPoint", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "//.", "rule"}], "&"}], ",", "expr"}], "]"}]}]}], 
    "]"}]}], "*)"}]], "Input",
 CellChangeTimes->{{3.9608316049296455`*^9, 3.9608316049296455`*^9}, {
