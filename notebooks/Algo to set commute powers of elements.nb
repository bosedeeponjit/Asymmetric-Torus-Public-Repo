  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rule2", "=", 
    RowBox[{
     RowBox[{"HoldPattern", "[", 
      RowBox[{"NonCommutativeMultiply", "[", 
