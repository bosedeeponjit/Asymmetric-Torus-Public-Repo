  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Unprotect", "[", "NonCommutativeMultiply", "]"}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Define", " ", "the", " ", "rules", " ", "using", " ", 
    RowBox[{"HoldPattern", ".", "This"}], " ", "is", " ", "crucial", " ", 
