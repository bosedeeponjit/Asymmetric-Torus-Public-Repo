            RowBox[{"inv", "[", "a2", "]"}], "^", "_"}]}], ")"}]}], ",", 
        "right___"}], "]"}], "]"}], ":>", 
     RowBox[{"NonCommutativeMultiply", "[", 
      RowBox[{"left", ",", "q", ",", "p", ",", "right"}], "]"}]}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "Prepend", " ", "our", " ", "rules", " ", "to", " ", "the", " ", 
     "existing", " ", "DownValues", " ", 
     RowBox[{"(", "definitions", ")"}], " ", "of", " ", "the", " ", 
     "NonCommutativeMultiply", " ", 
     RowBox[{"function", ".", "This"}], " ", "places", " ", "our", " ", 
