         RowBox[{"(", 
          RowBox[{"k", "|", 
           RowBox[{"k", "^", "_"}]}], ")"}]}], ",", 
        RowBox[{"q", ":", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"inv", "[", "a2", "]"}], "|", 
