Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"swapLogic", "[", "ncm_NonCommutativeMultiply", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "elemList", ",", "pivotPositions", ",", "lastPivotPosition", ",", 
        "prefix", ",", "suffix"}], "}"}], ",", 
      RowBox[{"(*", 
       RowBox[{
       "1.", " ", "Convert", " ", "the", " ", "expression", " ", "into", " ", 
        "a", " ", "list"}], "*)"}], 
      RowBox[{
       RowBox[{"elemList", "=", 
        RowBox[{"List", "@@", "ncm"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "2.", " ", "Find", " ", "the", " ", "positions", " ", "of", " ", 
         "d1k", " ", "or", " ", "d2k"}], "*)"}], 
       RowBox[{"pivotPositions", "=", 
        RowBox[{"Position", "[", 
         RowBox[{"elemList", ",", 
          RowBox[{
          "d1k", "|", "d2k", " ", "|", " ", "d11k", " ", "|", " ", "d12k", 
           " ", "|", " ", "d22k"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
         "3.", " ", "If", " ", "no", " ", "pivot", " ", "is", " ", "found"}], 
         ",", 
         RowBox[{
         "or", " ", "the", " ", "pivot", " ", "is", " ", "the", " ", "last", " ",
           "element"}], ",", 
         RowBox[{"return", " ", "unchanged"}]}], "*)"}], 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"pivotPositions", "===", 
           RowBox[{"{", "}"}]}], "||", 
          RowBox[{
           RowBox[{
            RowBox[{"Last", "[", "pivotPositions", "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}], "==", 
           RowBox[{"Length", "[", "elemList", "]"}]}]}], ",", 
         RowBox[{"Return", "[", "ncm", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "4.", " ", "Get", " ", "the", " ", "position", " ", "of", " ", "the", 
         " ", "LAST", " ", "pivot"}], "*)"}], 
       RowBox[{"lastPivotPosition", "=", 
        RowBox[{
         RowBox[{"Last", "[", "pivotPositions", "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"5.", " ", "Split", " ", "the", " ", "list"}], "*)"}], 
       RowBox[{"prefix", "=", 
        RowBox[{"Take", "[", 
         RowBox[{"elemList", ",", "lastPivotPosition"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"suffix", "=", 
        RowBox[{"Take", "[", 
         RowBox[{"elemList", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"lastPivotPosition", "+", "1"}], ",", 
            RowBox[{"-", "1"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "6.", " ", "Reassemble", " ", "and", " ", "return", " ", "the", " ", 
         "swapped", " ", "expression"}], "*)"}], 
       RowBox[{"NonCommutativeMultiply", "@@", 
        RowBox[{"Join", "[", 
         RowBox[{"suffix", ",", "prefix"}], "]"}]}]}]}], "]"}]}], ";"}], "\n",
   "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Main", " ", "rule", " ", "function", " ", "that", " ", "uses", " ", 
    "NCReplaceAll", " ", "to", " ", "handle", " ", "different", " ", 
    RowBox[{"cases", ".", "It"}], " ", "looks", " ", "for", " ", "a", " ", 
    "NonCommutativeMultiply", " ", "part", " ", "and", " ", "applies", " ", 
    "the", " ", "swapLogic", " ", "to", " ", 
    RowBox[{"it", "."}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"performSwapRule", "[", "expr_", "]"}], ":=", " ", 
  RowBox[{"NCReplaceAll", "[", 
   RowBox[{"expr", ",", " ", 
    RowBox[{"{", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"Case", " ", "1"}], ":", 
       RowBox[{
       "An", " ", "NCM", " ", "expression", " ", "multiplied", " ", "by", " ",
         "a", " ", "scalar", " ", "coefficient", 
        RowBox[{"(", "s", ")"}]}]}], "*)"}], " ", 
     RowBox[{
      RowBox[{
       RowBox[{"c___", "*", "ncm_NonCommutativeMultiply"}], ":>", 
       RowBox[{
        RowBox[{"(", "c", ")"}], "*", 
        RowBox[{"swapLogic", "[", "ncm", "]"}]}]}], ",", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Case", " ", "2"}], ":", 
        RowBox[{"A", " ", "pure", " ", "NCM", " ", "expression", " ", 
         RowBox[{"(", 
          RowBox[{"no", " ", "scalar", " ", "coefficient"}], ")"}]}]}], 
       "*)"}], 
      RowBox[{"ncm_NonCommutativeMultiply", ":>", 
       RowBox[{"swapLogic", "[", "ncm", "]"}]}]}], "}"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"performSwapRule", "[", 
     RowBox[{"expr1_", " ", "+", " ", "expr2_"}], "]"}], ":=", " ", 
    RowBox[{
     RowBox[{"performSwapRule", "[", "expr1", "]"}], " ", "+", " ", 
     RowBox[{"performSwapRule", "[", "expr2", "]"}]}]}], ";"}], 
  " "}]}], "Input",
 CellChangeTimes->{{3.9633698267506943`*^9, 3.9633698267506943`*^9}, {
   3.963389951248909*^9, 3.9633899692948074`*^9}, 3.963390615543358*^9, {
