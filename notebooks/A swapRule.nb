Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
   "Define", " ", "the", " ", "generators", " ", "for", " ", "the", " ", 
    "two", " ", "commuting", " ", "algebras"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"generatorsA", "=", 
     RowBox[{"{", 
      RowBox[{
      "a", ",", "b", ",", "c", ",", "ua", ",", "ub", ",", "va", ",", "vb", ",",
        "wa", ",", "wb"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"generatorsAprime", "=", 
     RowBox[{"{", 
      RowBox[{
      "k", ",", "a2", ",", "b2", ",", "d1k", ",", "d2k", ",", " ", "d11k", ",",
        "d12k", ",", "d21k", ",", "d22k"}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Set", " ", "the", " ", "elements", " ", "of", " ", "the", " ", "two", " ",
      "algebras", " ", "to", " ", "commute", " ", "with", " ", "each", " ", 
     "other"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"SetNonCommutative", "[", "generatorsA", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"SetNonCommutative", "[", "generatorsAprime", "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"b2", "=", 
     RowBox[{"inv", "[", "a2", "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Unprotect", "[", "NonCommutativeMultiply", "]"}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Define", " ", "the", " ", "rules", " ", "using", " ", 
     RowBox[{"HoldPattern", ".", "This"}], " ", "is", " ", "crucial", " ", 
     "for", " ", "directly", " ", "modifying", " ", 
     RowBox[{"DownValues", "."}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rule1", "=", 
     RowBox[{
      RowBox[{"HoldPattern", "[", 
       RowBox[{"NonCommutativeMultiply", "[", 
        RowBox[{"left___", ",", 
         RowBox[{"p", ":", 
          RowBox[{"(", 
           RowBox[{"k", "|", 
            RowBox[{"k", "^", "_"}]}], ")"}]}], ",", 
         RowBox[{"q", ":", 
          RowBox[{"(", 
           RowBox[{"a2", "|", 
            RowBox[{"a2", "^", "_"}]}], ")"}]}], ",", "right___"}], "]"}], 
       "]"}], ":>", 
      RowBox[{"NonCommutativeMultiply", "[", 
       RowBox[{"left", ",", "q", ",", "p", ",", "right"}], "]"}]}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rule2", "=", 
     RowBox[{
      RowBox[{"HoldPattern", "[", 
       RowBox[{"NonCommutativeMultiply", "[", 
        RowBox[{"left___", ",", 
         RowBox[{"p", ":", 
          RowBox[{"(", 
           RowBox[{"k", "|", 
            RowBox[{"k", "^", "_"}]}], ")"}]}], ",", 
         RowBox[{"q", ":", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"inv", "[", "a2", "]"}], "|", 
            RowBox[{
             RowBox[{"inv", "[", "a2", "]"}], "^", "_"}]}], ")"}]}], ",", 
         "right___"}], "]"}], "]"}], ":>", 
      RowBox[{"NonCommutativeMultiply", "[", 
       RowBox[{"left", ",", "q", ",", "p", ",", "right"}], "]"}]}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "Prepend", " ", "our", " ", "rules", " ", "to", " ", "the", " ", 
      "existing", " ", "DownValues", " ", 
      RowBox[{"(", "definitions", ")"}], " ", "of", " ", "the", " ", 
      "NonCommutativeMultiply", " ", 
      RowBox[{"function", ".", "This"}], " ", "places", " ", "our", " ", 
      "rules", " ", "at", " ", "the", " ", "top", " ", "of", " ", "the", " ", 
      "list"}], ",", 
     RowBox[{"ensuring", " ", "they", " ", "are", " ", "tried", " ", 
      RowBox[{"first", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"DownValues", "[", "NonCommutativeMultiply", "]"}], "=", 
     RowBox[{"Prepend", "[", 
      RowBox[{
       RowBox[{"DownValues", "[", "NonCommutativeMultiply", "]"}], ",", 
       "rule1"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"DownValues", "[", "NonCommutativeMultiply", "]"}], "=", 
     RowBox[{"Prepend", "[", 
      RowBox[{
       RowBox[{"DownValues", "[", "NonCommutativeMultiply", "]"}], ",", 
       "rule2"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Finally", ",", 
     RowBox[{"re", "-", 
      RowBox[{"protect", " ", "the", " ", 
       RowBox[{"function", "."}]}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"Protect", "[", "NonCommutativeMultiply", "]"}], ";"}], "\n", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Define", " ", "helper", " ", "functions"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"isA", "[", "x_", "]"}], ":=", 
     RowBox[{"MemberQ", "[", 
      RowBox[{"generatorsA", ",", "x"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"isAprime", "[", "k_", "]"}], ":=", 
     RowBox[{"MemberQ", "[", 
      RowBox[{"generatorsAprime", ",", "k"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Clear", "[", "isAprime", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"isAprime", "[", "p_Symbol", "]"}], ":=", 
     RowBox[{"MemberQ", "[", 
      RowBox[{"generatorsAprime", ",", "p"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"isAprime", "[", 
      RowBox[{"Power", "[", 
       RowBox[{"base_", ",", "_"}], "]"}], "]"}], ":=", 
     RowBox[{"isAprime", "[", "base", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"isAprime", "[", 
      RowBox[{"inv", "[", "base_", "]"}], "]"}], ":=", 
     RowBox[{"isAprime", "[", "base", "]"}]}], ";"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "Add", " ", "a", " ", "rule", " ", "for", " ", "your", " ", "custom", " ",
       "function", " ", "symbol"}], ",", "d2k"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"isAprime", "[", "d2k", "]"}], "=", "True"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"The", " ", "swap", " ", "rule"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"swapAtoRightRule", "=", 
     RowBox[{
      RowBox[{"h___", "**", 
       RowBox[{"a_", "?", "isA"}], "**", 
       RowBox[{"p_", "?", "isAprime"}], "**", "t___"}], ":>", 
      RowBox[{"h", "**", "p", "**", "a", "**", "t"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sigmamatrices", " ", ":=", " ", 
     RowBox[{"{", 
      RowBox[{"s1", ",", " ", "s2", ",", "s3"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"SetNonCommutative", "[", "sigmamatrices", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"moveSigmaLeftRule", "=", 
     RowBox[{"expr_NonCommutativeMultiply", ":>", 
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"terms", "=", 
           RowBox[{"List", "@@", "expr"}]}], ",", 
          RowBox[{"sigmas", "=", 
           RowBox[{"Cases", "[", 
            RowBox[{
             RowBox[{"List", "@@", "expr"}], ",", 
             RowBox[{"Alternatives", "@@", "sigmamatrices"}]}], "]"}]}], ",", 
          RowBox[{"others", "=", 
           RowBox[{"DeleteCases", "[", 
            RowBox[{
             RowBox[{"List", "@@", "expr"}], ",", 
             RowBox[{"Alternatives", "@@", "sigmamatrices"}]}], "]"}]}]}], 
         "}"}], ",", 
        RowBox[{
         RowBox[{"NonCommutativeMultiply", "@@", 
          RowBox[{"Join", "[", 
           RowBox[{"sigmas", ",", "others"}], "]"}]}], "/;", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Join", "[", 
            RowBox[{"sigmas", ",", "others"}], "]"}], "=!=", "terms"}], 
          ")"}]}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sigmarules", " ", ":=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"s1", "**", "s1"}], " ", ":>", " ", "1"}], " ", ",", 
       RowBox[{
        RowBox[{"s1", "**", "s1", "**", "s1"}], " ", ":>", " ", "s1"}], ",", 
       "  ", 
       RowBox[{
        RowBox[{"s2", "**", "s2"}], " ", ":>", "1"}], " ", ",", 
       RowBox[{
        RowBox[{"s2", "**", "s2", "**", "s2"}], " ", ":>", " ", "s2"}], ",", 
       " ", 
       RowBox[{
        RowBox[{"s3", "**", "s3"}], ":>", " ", "1"}], " ", ",", 
       RowBox[{
        RowBox[{"s3", "**", "s3", "**", "s3"}], " ", ":>", " ", "s3"}], ",", 
       " ", 
       RowBox[{
        RowBox[{"s1", "**", "s2"}], " ", ":>", " ", 
        RowBox[{"\[ImaginaryI]", " ", "**", "s3"}]}], ",", " ", 
       RowBox[{
        RowBox[{"s2", "**", "s1"}], " ", ":>", " ", 
        RowBox[{"-", 
         RowBox[{"\[ImaginaryI]", "**", "s3"}]}]}], ",", " ", 
       RowBox[{
        RowBox[{"s2", "**", "s3"}], " ", ":>", " ", 
        RowBox[{"\[ImaginaryI]", " ", "**", "s1"}]}], ",", " ", 
       RowBox[{
        RowBox[{"s3", "**", "s2"}], " ", ":>", " ", 
        RowBox[{"-", 
         RowBox[{"\[ImaginaryI]", "**", "s1"}]}]}], ",", " ", 
       RowBox[{
        RowBox[{"s3", "**", "s1"}], " ", ":>", " ", 
        RowBox[{"\[ImaginaryI]", " ", "**", "s2"}]}], ",", " ", 
       RowBox[{
        RowBox[{"s1", "**", "s3"}], " ", ":>", " ", 
        RowBox[{"-", 
         RowBox[{"\[ImaginaryI]", "**", "s2"}]}]}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Format", "[", "s1", "]"}], " ", ":=", " ", 
     RowBox[{"HoldForm", "[", 
      SuperscriptBox["\[Sigma]", "1"], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Format", "[", "s2", "]"}], " ", ":=", " ", 
     RowBox[{"HoldForm", "[", 
      SuperscriptBox["\[Sigma]", "2"], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Format", "[", "s3", "]"}], " ", ":=", " ", 
     RowBox[{"HoldForm", "[", 
      SuperscriptBox["\[Sigma]", "3"], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\n", "\n", "\[IndentingNewLine]"}]}]], "Input",
