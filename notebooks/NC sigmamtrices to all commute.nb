Cell[BoxData[
 RowBox[{
  RowBox[{"moveSigmaLeftRule", "=", 
   RowBox[{"expr_NonCommutativeMultiply", ":>", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"terms", "=", 
         RowBox[{"List", "@@", "expr"}]}], ",", 
        RowBox[{"sigmas", "=", 
         RowBox[{"Cases", "[", 
          RowBox[{
           RowBox[{"List", "@@", "expr"}], ",", 
           RowBox[{"Alternatives", "@@", "sigma"}]}], "]"}]}], ",", 
        RowBox[{"others", "=", 
         RowBox[{"DeleteCases", "[", 
          RowBox[{
           RowBox[{"List", "@@", "expr"}], ",", 
           RowBox[{"Alternatives", "@@", "sigma"}]}], "]"}]}]}], "}"}], ",", 
      RowBox[{
       RowBox[{"NonCommutativeMultiply", "@@", 
        RowBox[{"Join", "[", 
         RowBox[{"sigmas", ",", "others"}], "]"}]}], "/;", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Join", "[", 
          RowBox[{"sigmas", ",", "others"}], "]"}], "=!=", "terms"}], 
        ")"}]}]}], "]"}]}]}], ";"}]], "Input",
