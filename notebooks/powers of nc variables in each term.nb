 RowBox[{
  RowBox[{"GenerateLatexTable", "[", "dataset_Dataset", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "headerLine1", ",", "headerLine2", ",", "bodyString", ",", "preamble", ",",
       "firstHead", ",", "contHead", ",", "foot", ",", "lastFoot", ",", 
      "tableEnd", ",", "dataRows", ",", "formattedRows", ",", "formatRow", ",",
       "formatElement"}], "}"}], ",", 
    RowBox[{"(*", 
     RowBox[{
     "Helper", " ", "function", " ", "to", " ", "format", " ", "individual", " ",
       "expressions", " ", "for", " ", "LaTeX"}], "*)"}], 
    RowBox[{
     RowBox[{
      RowBox[{"formatElement", "[", "expr_", "]"}], ":=", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", "texString", "}"}], ",", 
        RowBox[{
         RowBox[{"texString", "=", 
          RowBox[{"ToString", "[", 
           RowBox[{"expr", ",", "TeXForm"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
          "Replaces", " ", "the", " ", "first", " ", "space", " ", "after", " ",
            "a", " ", "leading", " ", "numerical", " ", "coefficient", " ", 
           "with", " ", "a", " ", "thin", " ", "space", " ", 
           RowBox[{"(", 
            RowBox[{"\\", ","}], ")"}], " ", "for", " ", "better", " ", 
           "typesetting"}], "*)"}], 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"StringMatchQ", "[", 
            RowBox[{"texString", ",", 
             RowBox[{
             "RegularExpression", 
              "[", "\"\<^\\\\s*-?\\\\d+(\\\\.\\\\d+)?\\\\s+.*\>\"", "]"}]}], 
            "]"}], ",", 
           RowBox[{"texString", "=", 
            RowBox[{"StringReplace", "[", 
             RowBox[{"texString", ",", 
              RowBox[{"\"\< \>\"", "->", "\"\<\\\\, \>\""}], ",", "1"}], 
             "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"\"\<$\>\"", "<>", 
          RowBox[{"StringTrim", "[", "texString", "]"}], 
          "<>", "\"\<$\>\""}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"MODIFICATION", " ", "1"}], ":", 
       RowBox[{
        RowBox[{"Reworked", "'"}], 
        RowBox[{"formatRow", "'"}], " ", "to", " ", "handle", " ", "the", " ",
         "new", " ", "column", " ", "structure"}]}], "*)"}], 
     RowBox[{
      RowBox[{"formatRow", "[", "row_List", "]"}], ":=", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"slNo", ",", "term", ",", "middle", ",", "last"}], "}"}], ",", 
        RowBox[{
         RowBox[{"slNo", "=", 
          RowBox[{"ToString", "[", 
           RowBox[{"First", "[", "row", "]"}], "]"}]}], ";", 
         RowBox[{"(*", 
          RowBox[{"SL", " ", 
           RowBox[{"No", ".", "as"}], " ", "plain", " ", "string"}], "*)"}], 
         RowBox[{"term", "=", 
          RowBox[{"formatElement", "[", 
           RowBox[{"row", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "]"}]}], ";", 
         RowBox[{"(*", 
          
          RowBox[{"\"\<Term\>\"", " ", "column", " ", "in", " ", "math", " ", 
           "mode"}], "*)"}], 
         RowBox[{"middle", "=", 
          RowBox[{"ToString", "/@", 
           RowBox[{"Take", "[", 
            RowBox[{"row", ",", 
             RowBox[{"{", 
              RowBox[{"3", ",", 
               RowBox[{"-", "2"}]}], "}"}]}], "]"}]}]}], ";", 
         RowBox[{"(*", 
          RowBox[{
          "Middle", " ", "columns", " ", "as", " ", "plain", " ", "strings"}],
           "*)"}], 
         RowBox[{"last", "=", 
          RowBox[{"formatElement", "[", 
           RowBox[{"Last", "[", "row", "]"}], "]"}]}], ";", 
