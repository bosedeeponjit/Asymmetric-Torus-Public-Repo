 TemplateBox[{
  "NCAlgebra", "SmallCapSymbolsNonCommutative", 
   "\"All lower cap single letter symbols (e.g. a,b,c,...) were set as \
noncommutative.\"", 2, 1, 1, 22369709471525490908, "Local", 
   "NCAlgebra`NCAlgebra"},
