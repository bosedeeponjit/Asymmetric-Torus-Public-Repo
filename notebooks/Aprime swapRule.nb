Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"Define", " ", "the", " ", "generator", " ", "sets"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"generatorsA", "=", 
     RowBox[{"{", 
      RowBox[{
      "a", ",", "b", ",", "c", ",", "ua", ",", "ub", ",", "va", ",", "vb", ",",
        "wa", ",", "wb"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"generatorsAprime", "=", 
     RowBox[{"{", 
      RowBox[{"k", ",", "a2", ",", "b2", ",", "d1k", ",", "d2k"}], "}"}]}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"SetNonCommutative", "[", "generatorsA", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"SetNonCommutative", "[", "generatorsAprime", "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Define", " ", "helper", " ", "functions"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"isA", "[", "x_", "]"}], ":=", 
     RowBox[{"MemberQ", "[", 
      RowBox[{"generatorsA", ",", "x"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"isAprime", "[", "k_", "]"}], ":=", 
     RowBox[{"MemberQ", "[", 
      RowBox[{"generatorsAprime", ",", "k"}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Define", " ", "the", " ", "swap", " ", "rule"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"swapRule", "=", 
     RowBox[{
      RowBox[{"h___", "**", 
       RowBox[{"p_", "?", "isAprime"}], "**", 
       RowBox[{"a_", "?", "isA"}], "**", "t___"}], ":>", 
      RowBox[{"h", "**", "a", "**", "p", "**", "t"}]}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Create", " ", "a", " ", "sample", " ", "expression", " ", "with", " ", 
     "mixed", " ", "elements"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"expr", "=", 
     RowBox[{
     "a", "**", "k", "**", "b", "**", "a2", "**", "c", "**", "d1k"}]}], ";"}],
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Apply", " ", "the", " ", "rule", " ", "repeatedly", " ", "to", " ", 
     "sort", " ", "the", " ", "expression"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"sortedExpr", "=", " ", 
     RowBox[{"NCReplaceRepeated", "[", 
      RowBox[{"expr", ",", "swapRule"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Display", " ", "the", " ", "result"}], "*)"}], "\n", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Original Expression: \>\"", ",", 
     RowBox[{"NCFormat", "[", "expr", "]"}]}], "]"}], "\n", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Sorted Expression: \>\"", ",", 
     RowBox[{"NCFormat", "[", "sortedExpr", "]"}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.9629644203599434`*^9, 3.9629645175107517`*^9}},
 CellLabel->"In[2]:=",ExpressionUUID->"a9e6ec75-c2e5-3548-b130-b33201612ad2"],

Cell[CellGroupData[{

