Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Unprotect", " ", "the", " ", "built"}], "-", 
    RowBox[{
    "in", " ", "D", " ", "function", " ", "to", " ", "add", " ", "new", " ", 
     "rules"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Unprotect", "[", "D", "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   
   RowBox[{"(*", 
    RowBox[{
    "Add", " ", "the", " ", "product", " ", "rule", " ", "for", " ", "D", " ",
      "acting", " ", "on", " ", "NonCommutativeMultiply"}], " ", 
    RowBox[{"(*", "*)"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"f_", "**", "g_"}], ",", "var_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{"f", ",", "var"}], "]"}], "**", "g"}], "+", 
      RowBox[{"f", "**", 
       RowBox[{"D", "[", 
        RowBox[{"g", ",", "var"}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{"(*", 
    RowBox[{"Define", " ", "the", " ", "derivative", " ", "of", " ", 
     RowBox[{"inv", "[", "f", "]"}], " ", "with", " ", "respect", " ", "to", " ",
      "any", " ", 
     RowBox[{"variable", "'"}], 
     RowBox[{"var", "'"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "This", " ", "applies", " ", "the", " ", "chain", " ", "rule", " ", "in",
       " ", "a", " ", "non"}], "-", 
     RowBox[{"commutative", " ", 
      RowBox[{"setting", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"inv", "[", "f_", "]"}], ",", "var_"}], "]"}], ":=", 
     RowBox[{"-", 
      RowBox[{
       RowBox[{"inv", "[", "f", "]"}], "**", 
       RowBox[{"D", "[", 
        RowBox[{"f", ",", "var"}], "]"}], "**", 
       RowBox[{"inv", "[", "f", "]"}]}]}]}], ";"}], "\n", 
