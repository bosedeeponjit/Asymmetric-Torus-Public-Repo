    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "elemList", ",", "pivotPositions", ",", "lastPivotPosition", ",", 
        "prefix", ",", "suffix"}], "}"}], ",", 
      RowBox[{"(*", 
       RowBox[{
       "1.", " ", "Convert", " ", "the", " ", "expression", " ", "into", " ", 
        "a", " ", "list"}], "*)"}], 
      RowBox[{
       RowBox[{"elemList", "=", 
        RowBox[{"List", "@@", "ncm"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "2.", " ", "Find", " ", "the", " ", "positions", " ", "of", " ", 
         "d1k", " ", "or", " ", "d2k"}], "*)"}], 
       RowBox[{"pivotPositions", "=", 
        RowBox[{"Position", "[", 
         RowBox[{"elemList", ",", 
          RowBox[{
          "d1k", "|", "d2k", " ", "|", " ", "d11k", " ", "|", " ", "d12k", 
           " ", "|", " ", "d22k"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
