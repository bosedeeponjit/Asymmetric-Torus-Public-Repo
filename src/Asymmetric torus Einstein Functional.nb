   TemplateBox[{
     SuperscriptBox[
      RowBox[{"(", 
        TagBox[
         SubscriptBox["b", "0"], HoldForm], ")"}], "4"], 
     SuperscriptBox["k", "9"], 
     TagBox[
      RowBox[{
        SubscriptBox["\[Delta]", "2"], "[", "k", "]"}], HoldForm], 
     TagBox[
      SubscriptBox["b", "0"], HoldForm], "k", 
     TagBox[
      RowBox[{
        SubscriptBox["\[Delta]", "2"], "[", "k", "]"}], HoldForm]},
    "RowDefault"]}]}]], "Output",
