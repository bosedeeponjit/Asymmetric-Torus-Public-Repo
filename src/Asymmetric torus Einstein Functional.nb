Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"filterD1kD2k", "[", "exprs_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "test", "}"}], ",", 
       RowBox[{"(*", 
        RowBox[{
        "This", " ", "test", " ", "returns", " ", "True", " ", "if", " ", "a",
          " ", "term", " ", "has", " ", "exactly", " ", "one", " ", "d1k", " ",
          "and", " ", "one", " ", "d2k"}], "*)"}], 
       RowBox[{
        RowBox[{
         RowBox[{"test", "[", "term_", "]"}], ":=", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"Count", "[", 
             RowBox[{"term", ",", "d1k", ",", "Infinity"}], "]"}], "==", 
            "1"}], "&&", 
           RowBox[{
            RowBox[{"Count", "[", 
             RowBox[{"term", ",", "d2k", ",", "Infinity"}], "]"}], "==", 
            "1"}]}], ")"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{
          "If", " ", "the", " ", "expression", " ", "is", " ", "a", " ", 
           "sum"}], ",", 
          RowBox[{
          "select", " ", "terms", " ", "that", " ", "pass", " ", "the", " ", 
           RowBox[{"test", "."}]}]}], "*)"}], 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"If", " ", 
           RowBox[{"it", "'"}], "s", " ", "a", " ", "single", " ", "term"}], ",", 
          RowBox[{
          "return", " ", "the", " ", "term", " ", "if", " ", "it", " ", 
           "passes"}], ",", 
          RowBox[{"otherwise", " ", "return", " ", "0."}]}], "*)"}], 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Head", "[", "exprs", "]"}], "===", "Plus"}], ",", 
          RowBox[{"Select", "[", 
           RowBox[{"exprs", ",", "test"}], "]"}], ",", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"test", "[", "exprs", "]"}], ",", "exprs", ",", "0"}], 
           "]"}]}], "]"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"filterD1kD1k", "[", "expr_", "]"}], ":=", 
     RowBox[{"Total", "@", 
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Head", "[", "expr", "]"}], "===", "Plus"}], ",", 
          RowBox[{"List", "@@", "expr"}], ",", 
          RowBox[{"{", "expr", "}"}]}], "]"}], ",", 
        RowBox[{
         RowBox[{"FreeQ", "[", 
          RowBox[{"#", ",", "d2k"}], "]"}], "&"}]}], "]"}]}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"filterD2kD2k", "[", "expr_", "]"}], ":=", 
     RowBox[{"Total", "@", 
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Head", "[", "expr", "]"}], "===", "Plus"}], ",", 
          RowBox[{"List", "@@", "expr"}], ",", 
          RowBox[{"{", "expr", "}"}]}], "]"}], ",", 
        RowBox[{
         RowBox[{"FreeQ", "[", 
          RowBox[{"#", ",", "d1k"}], "]"}], "&"}]}], "]"}]}]}], ";"}], "*)"}],
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", "filterTerms", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"filterTerms", "[", 
      RowBox[{"expr_", ",", 
       RowBox[{"{", 
        RowBox[{"elem1_", ",", "elem2_"}], "}"}], ",", 
       RowBox[{"allD_List", ":", 
        RowBox[{"{", 
         RowBox[{"d1k", ",", "d2k"}], "}"}]}]}], "]"}], ":=", 
     RowBox[{"Which", "[", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Case", " ", "1"}], ":", 
        RowBox[{"Different", " ", 
         RowBox[{"elements", ".", "Logic"}], " ", "is", " ", 
         RowBox[{"unchanged", "."}]}]}], "*)"}], 
      RowBox[{
       RowBox[{"elem1", "=!=", "elem2"}], ",", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", "test", "}"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"test", "[", "term_", "]"}], ":=", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"Count", "[", 
               RowBox[{"term", ",", "elem1", ",", "Infinity"}], "]"}], "==", 
              "1"}], "&&", 
             RowBox[{
              RowBox[{"Count", "[", 
               RowBox[{"term", ",", "elem2", ",", "Infinity"}], "]"}], "==", 
              "1"}]}], ")"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Head", "[", "expr", "]"}], "===", "Plus"}], ",", 
            RowBox[{"Select", "[", 
             RowBox[{"expr", ",", "test"}], "]"}], ",", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"test", "[", "expr", "]"}], ",", "expr", ",", "0"}], 
             "]"}]}], "]"}]}]}], "]"}], ",", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Case", " ", "2"}], ":", 
         RowBox[{"Identical", " ", 
          RowBox[{"elements", ".", "Logic"}], " ", "is", " ", "now", " ", 
          RowBox[{"corrected", "."}]}]}], "*)"}], 
       RowBox[{"elem1", "===", "elem2"}], ",", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"elementToRemove", ",", "test"}], "}"}], ",", 
         RowBox[{
          RowBox[{"elementToRemove", "=", 
           RowBox[{"First", "@", 
            RowBox[{"Complement", "[", 
             RowBox[{"allD", ",", 
              RowBox[{"{", "elem1", "}"}]}], "]"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"CORRECTED", " ", 
            RowBox[{"TEST", ":", 
             RowBox[{
             "Term", " ", "must", " ", "contain", " ", "elem1", " ", "AND", " ",
               "be", " ", "free", " ", "of", " ", "elementToRemove"}]}]}], 
           "*)"}], 
          RowBox[{
           RowBox[{"test", "[", "term_", "]"}], ":=", 
           RowBox[{
            RowBox[{"!", 
             RowBox[{"FreeQ", "[", 
              RowBox[{"term", ",", "elem1"}], "]"}]}], "&&", 
            RowBox[{"FreeQ", "[", 
             RowBox[{"term", ",", "elementToRemove"}], "]"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Total", "@", 
           RowBox[{"Select", "[", 
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Head", "[", "expr", "]"}], "===", "Plus"}], ",", 
               RowBox[{"List", "@@", "expr"}], ",", 
               RowBox[{"{", "expr", "}"}]}], "]"}], ",", "test"}], 
            "]"}]}]}]}], "]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.9665927156270275`*^9, 3.9665927156270275`*^9}, {
