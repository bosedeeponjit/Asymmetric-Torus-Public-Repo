Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SumFValues", "[", "analysis_Dataset", "]"}], ":=", 
   RowBox[{"Total", "[", 
    RowBox[{"analysis", "[", 
     RowBox[{"All", ",", "\"\<F(s, m, n, \[Beta], B)\>\""}], "]"}], "]"}]}], 
