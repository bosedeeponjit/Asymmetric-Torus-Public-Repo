Cell[BoxData[
 RowBox[{
  RowBox[{"GenerateLatexTable", "[", "dataset_Dataset", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "headerLine1", ",", "headerLine2", ",", "bodyString", ",", "preamble", ",",
       "firstHead", ",", "contHead", ",", "foot", ",", "lastFoot", ",", 
      "tableEnd", ",", "dataRows", ",", "formattedRows", ",", "formatRow", ",",
       "formatElement"}], "}"}], ",", 
    RowBox[{"(*", 
     RowBox[{
     "Helper", " ", "function", " ", "to", " ", "format", " ", "individual", " ",
       "expressions", " ", "for", " ", "LaTeX"}], "*)"}], 
    RowBox[{
     RowBox[{
      RowBox[{"formatElement", "[", "expr_", "]"}], ":=", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", "texString", "}"}], ",", 
        RowBox[{
         RowBox[{"texString", "=", 
          RowBox[{"ToString", "[", 
           RowBox[{"expr", ",", "TeXForm"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
          "Replaces", " ", "the", " ", "first", " ", "space", " ", "after", " ",
            "a", " ", "leading", " ", "numerical", " ", "coefficient", " ", 
           "with", " ", "a", " ", "thin", " ", "space", " ", 
           RowBox[{"(", 
            RowBox[{"\\", ","}], ")"}], " ", "for", " ", "better", " ", 
           "typesetting"}], "*)"}], 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"StringMatchQ", "[", 
            RowBox[{"texString", ",", 
             RowBox[{
             "RegularExpression", 
              "[", "\"\<^\\\\s*-?\\\\d+(\\\\.\\\\d+)?\\\\s+.*\>\"", "]"}]}], 
            "]"}], ",", 
           RowBox[{"texString", "=", 
            RowBox[{"StringReplace", "[", 
             RowBox[{"texString", ",", 
              RowBox[{"\"\< \>\"", "->", "\"\<\\\\, \>\""}], ",", "1"}], 
             "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"\"\<$\>\"", "<>", 
          RowBox[{"StringTrim", "[", "texString", "]"}], 
          "<>", "\"\<$\>\""}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"MODIFICATION", " ", "1"}], ":", 
       RowBox[{
        RowBox[{"Reworked", "'"}], 
        RowBox[{"formatRow", "'"}], " ", "to", " ", "handle", " ", "the", " ",
         "new", " ", "column", " ", "structure"}]}], "*)"}], 
     RowBox[{
      RowBox[{"formatRow", "[", "row_List", "]"}], ":=", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"slNo", ",", "term", ",", "middle", ",", "last"}], "}"}], ",", 
        RowBox[{
         RowBox[{"slNo", "=", 
          RowBox[{"ToString", "[", 
           RowBox[{"First", "[", "row", "]"}], "]"}]}], ";", 
         RowBox[{"(*", 
          RowBox[{"SL", " ", 
           RowBox[{"No", ".", "as"}], " ", "plain", " ", "string"}], "*)"}], 
         RowBox[{"term", "=", 
          RowBox[{"formatElement", "[", 
           RowBox[{"row", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "]"}]}], ";", 
         RowBox[{"(*", 
          
          RowBox[{"\"\<Term\>\"", " ", "column", " ", "in", " ", "math", " ", 
           "mode"}], "*)"}], 
         RowBox[{"middle", "=", 
          RowBox[{"ToString", "/@", 
           RowBox[{"Take", "[", 
            RowBox[{"row", ",", 
             RowBox[{"{", 
              RowBox[{"3", ",", 
               RowBox[{"-", "2"}]}], "}"}]}], "]"}]}]}], ";", 
         RowBox[{"(*", 
          RowBox[{
          "Middle", " ", "columns", " ", "as", " ", "plain", " ", "strings"}],
           "*)"}], 
         RowBox[{"last", "=", 
          RowBox[{"formatElement", "[", 
           RowBox[{"Last", "[", "row", "]"}], "]"}]}], ";", 
         RowBox[{"(*", 
          RowBox[{
          "Last", " ", "column", " ", "in", " ", "math", " ", "mode"}], 
          "*)"}], 
         RowBox[{"StringRiffle", "[", 
          RowBox[{
           RowBox[{"Join", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"slNo", ",", "term"}], "}"}], ",", "middle", ",", 
             RowBox[{"{", "last", "}"}]}], "]"}], ",", "\"\< & \>\""}], 
          "]"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{
        RowBox[{"--", 
         RowBox[{"-", "MODIFIED"}]}], " ", "LATEX", " ", "STRUCTURE", " ", 
        RowBox[{"DEFINITIONS", "--"}]}], "-"}], "*)"}], 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"MODIFICATION", " ", "2"}], ":", 
       RowBox[{"Added", " ", "a", " ", 
        RowBox[{"column", "'"}], 
        RowBox[{"c", "'"}], " ", "for", " ", "the", " ", "serial", " ", 
        "number", " ", "in", " ", "the", " ", "table", " ", "preamble"}]}], 
      "*)"}], 
     RowBox[{"preamble", "=", 
      RowBox[{"\"\<\\\\begin{longtable}{|c|l|c|c|c|c|c|c|c|c|c|}\\n\>\"", 
       "<>", "\"\<\\\\caption{Analysis of Expression Terms of the form $C \
\\\\,\\\\xi_1^{2\\\\alpha} \\\\xi_2^{2\\\\beta}b_0^m k^A \\\\delta_i(k)b_0^n \
k^B \\\\delta_j(k)$}\\\\label{tab}\\\\\\\\\\n\\\\hline\\n\>\""}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"MODIFICATION", " ", "3"}], ":", 
       RowBox[{
       "Added", " ", "\"\<SL No.\>\"", " ", "to", " ", "the", " ", "main", " ",
         "header"}]}], "*)"}], 
     RowBox[{"headerLine1", "=", 
      RowBox[{
       RowBox[{"StringRiffle", "[", 
        RowBox[{
         RowBox[{"{", 
          
          RowBox[{"\"\<\\\\multicolumn{1}{|c|}{SL No.}\>\"", 
