Cell[BoxData[
 RowBox[{
  RowBox[{"expr", " ", "=", " ", 
   RowBox[{
    RowBox[{
     SuperscriptBox["\[Xi]1", "2"], "*", 
     RowBox[{
      SuperscriptBox["\[Xi]2", "3"], "**", 
      SuperscriptBox["b0", "4"], "**", 
      SuperscriptBox["k", "8"], "**", 
      RowBox[{
       SubscriptBox["\[Delta]", "1"], "[", "k", "]"}], "**", 
      SuperscriptBox["b0", "2"], "**", 
      SuperscriptBox["k", "3"], "**", 
      RowBox[{
       SubscriptBox["\[Delta]", "2"], "[", "k", "]"}]}]}], " ", "-", 
    RowBox[{"2", "*", 
     RowBox[{
      SuperscriptBox["\[Xi]2", "3"], "**", 
      SuperscriptBox["b0", "4"], "**", 
      RowBox[{
       SubscriptBox["\[Delta]", "2"], "[", "k", "]"}], "**", 
      SuperscriptBox["b0", "1"], "**", 
      SuperscriptBox["k", "4"], "**", 
      RowBox[{
       SubscriptBox["\[Delta]", "1"], "[", "k", "]"}]}]}], "-", 
    RowBox[{"14", "*", 
     RowBox[{
      SuperscriptBox["\[Xi]1", "3"], "**", 
      SuperscriptBox["b0", "4"], "**", 
      RowBox[{
       SubscriptBox["\[Delta]", "1"], "[", "k", "]"}], "**", 
      SuperscriptBox["k", "7"], "**", 
      RowBox[{
       SubscriptBox["\[Delta]", "1"], "[", "k", "]"}]}]}], "+", 
    RowBox[{"7", 
     RowBox[{
      SuperscriptBox["\[Xi]1", "1"], "**", 
      SuperscriptBox["b0", "2"], "**", 
      RowBox[{
       SubscriptBox["\[Delta]", "2"], "[", "k", "]"}], "**", 
      SuperscriptBox["k", "5"], "**", 
      RowBox[{
