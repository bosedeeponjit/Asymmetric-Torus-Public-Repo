Cell[BoxData[
 RowBox[{
  RowBox[{"AnalyzeExpression", "[", "expression_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"terms", ",", "results", ",", "getPower", ",", "extractPowers"}],
      "}"}], ",", 
    RowBox[{
     RowBox[{
      RowBox[{"getPower", "[", 
       RowBox[{"var_Symbol", ",", "parts_List"}], "]"}], ":=", 
      RowBox[{"Total", "[", 
       RowBox[{"Replace", "[", 
        RowBox[{"parts", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Power", "[", 
              RowBox[{"v_Symbol", ",", "p_"}], "]"}], "/;", 
             RowBox[{"v", "===", "var"}]}], "->", "p"}], ",", 
           RowBox[{
            RowBox[{"v_Symbol", "/;", 
             RowBox[{"v", "===", "var"}]}], "->", "1"}], ",", 
           RowBox[{"_", "->", "0"}]}], "}"}], ",", 
         RowBox[{"{", "1", "}"}]}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"extractPowers", "[", 
       RowBox[{"term_", ",", "idx_List"}], "]"}], ":=", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"commPart", "=", "1"}], ",", "ncPart", ",", "ncList", ",", 
          "alpha", ",", "beta", ",", "m", ",", "A", ",", "n", ",", "B", ",", 
          "coeff", ",", "slNo", ",", "d1kPos", ",", "d2kPos"}], "}"}], ",", 
        RowBox[{
         RowBox[{"slNo", "=", 
          RowBox[{"First", "[", "idx", "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"Separate", " ", "commutative", " ", "and", " ", "non"}], "-", 
           RowBox[{"commutative", " ", "parts"}]}], "*)"}], 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Head", "[", "term", "]"}], "===", 
            "NonCommutativeMultiply"}], ",", 
           RowBox[{"ncPart", "=", "term"}], ",", 
           RowBox[{
            RowBox[{"ncPart", "=", 
             RowBox[{"First", "@", 
              RowBox[{"Cases", "[", 
               RowBox[{
               "term", ",", "_NonCommutativeMultiply", ",", "All", ",", "1", ",", 
                RowBox[{"Heads", "->", "True"}]}], "]"}]}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"commPart", "=", 
             RowBox[{"term", "/", "ncPart"}]}], ";"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"Extract", " ", "commutative", " ", "coefficients"}], 
          "*)"}], 
         RowBox[{"alpha", "=", 
          RowBox[{"Exponent", "[", 
           RowBox[{"commPart", ",", "\[Xi]1"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"beta", "=", 
          RowBox[{"Exponent", "[", 
           RowBox[{"commPart", ",", "\[Xi]2"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"coeff", "=", 
          RowBox[{"commPart", "/", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"\[Xi]1", "^", "alpha"}], "*", 
             RowBox[{"\[Xi]2", "^", "beta"}]}], ")"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"ncList", "=", 
          RowBox[{"List", "@@", "ncPart"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
          "Find", " ", "positions", " ", "of", " ", "the", " ", "specific", " ",
            "derivatives", " ", "d1k", " ", "and", " ", "d2k"}], "*)"}], 
         RowBox[{"d1kPos", "=", 
          RowBox[{"FirstPosition", "[", 
           RowBox[{"ncList", ",", "d1k"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"d2kPos", "=", 
          RowBox[{"FirstPosition", "[", 
           RowBox[{"ncList", ",", "d2k"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
          "Check", " ", "for", " ", "the", " ", "special", " ", "swap", " ", 
           RowBox[{"condition", ":", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"...", "**", "d2k", "**"}], "..."}], "**", "d1k", 
              "**"}], "..."}]}]}], "*)"}], 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"!", 
             RowBox[{"MissingQ", "[", "d2kPos", "]"}]}], "&&", 
            RowBox[{"!", 
             RowBox[{"MissingQ", "[", "d1kPos", "]"}]}], "&&", 
            RowBox[{
             RowBox[{"First", "[", "d2kPos", "]"}], "<", 
             RowBox[{"First", "[", "d1kPos", "]"}]}]}], ",", 
           RowBox[{"(*", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"--", 
                 RowBox[{"-", "SWAP"}]}], " ", "LOGIC", " ", "for", " ", "C", 
                "*"}], "..."}], "**", 
              RowBox[{"b0", "^", "m"}], "**", 
              RowBox[{"k", "^", "A"}], "**", "d2k", "**", 
              RowBox[{"b0", "^", "n"}], "**", 
              RowBox[{"k", "^", "B"}], "**", 
              RowBox[{"d1k", "--"}]}], "-"}], "*)"}], 
           RowBox[{"Module", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
              "beforeD2k", ",", "betweenDerivs", ",", "mReal", ",", "AReal", ",",
                "nReal", ",", "BReal"}], "}"}], ",", 
             RowBox[{"(*", 
              RowBox[{"Part", " ", "before", " ", "d2k", " ", "contains", " ", 
               RowBox[{"the", "'"}], 
               RowBox[{"real", "'"}], " ", "m", " ", "and", " ", "A"}], 
              "*)"}], 
             RowBox[{
              RowBox[{"beforeD2k", "=", 
               RowBox[{"Take", "[", 
                RowBox[{"ncList", ",", 
                 RowBox[{
                  RowBox[{"First", "[", "d2kPos", "]"}], "-", "1"}]}], 
                "]"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"(*", 
               RowBox[{
               "Part", " ", "between", " ", "d2k", " ", "and", " ", "d1k", " ",
                 "contains", " ", 
                RowBox[{"the", "'"}], 
                RowBox[{"real", "'"}], " ", "n", " ", "and", " ", "B"}], 
               "*)"}], 
              RowBox[{"betweenDerivs", "=", 
               RowBox[{"Take", "[", 
                RowBox[{"ncList", ",", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"First", "[", "d2kPos", "]"}], "+", "1"}], ",", 
                   RowBox[{
                    RowBox[{"First", "[", "d1kPos", "]"}], "-", "1"}]}], 
                  "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"(*", 
               RowBox[{"Calculate", " ", "real", " ", "powers"}], "*)"}], 
              RowBox[{"mReal", "=", 
               RowBox[{"getPower", "[", 
                RowBox[{"b0", ",", "beforeD2k"}], "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"AReal", "=", 
               RowBox[{"getPower", "[", 
                RowBox[{"k", ",", "beforeD2k"}], "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"nReal", "=", 
               RowBox[{"getPower", "[", 
                RowBox[{"b0", ",", "betweenDerivs"}], "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"BReal", "=", 
               RowBox[{"getPower", "[", 
                RowBox[{"k", ",", "betweenDerivs"}], "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"(*", 
               RowBox[{
               "Assign", " ", "swapped", " ", "values", " ", "as", " ", "per",
                 " ", "the", " ", "request"}], "*)"}], 
              RowBox[{"m", "=", "nReal"}], ";", "\[IndentingNewLine]", 
              RowBox[{"A", "=", "BReal"}], ";", "\[IndentingNewLine]", 
              RowBox[{"n", "=", "mReal"}], ";", "\[IndentingNewLine]", 
              RowBox[{"B", "=", "AReal"}], ";"}]}], "]"}], ",", 
           RowBox[{"(*", 
            RowBox[{
             RowBox[{
              RowBox[{"--", 
               RowBox[{"-", "ORIGINAL"}]}], " ", "LOGIC", " ", "for", " ", 
              "all", " ", "other", " ", 
              RowBox[{"cases", "--"}]}], "-"}], "*)"}], 
           RowBox[{"Module", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"derivPos", ",", "beforeDeriv", ",", "afterDeriv"}], 
              "}"}], ",", 
             RowBox[{"(*", 
              RowBox[{
              "Find", " ", "the", " ", "first", " ", "derivative", " ", "of", 
               " ", "k", " ", "of", " ", "any", " ", "type"}], "*)"}], 
             RowBox[{
              RowBox[{"derivPos", "=", 
               RowBox[{"FirstPosition", "[", 
                RowBox[{"ncList", ",", 
                 RowBox[{
                 "d1k", "|", "d2k", "|", "d11k", "|", "d12k", "|", "d22k"}]}],
                 "]"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"MissingQ", "[", "derivPos", "]"}], ",", 
                RowBox[{"Return", "@", 
                 RowBox[{"<|", 
                  RowBox[{
                   RowBox[{"\"\<SL No.\>\"", "->", "slNo"}], ",", 
                   RowBox[{"\"\<Term\>\"", "->", "term"}], ",", 
                   
                   RowBox[{"\"\<Status\>\"", 
                    "->", "\"\<No k-derivative found\>\""}]}], "|>"}]}]}], 
               "]"}], ";", "\[IndentingNewLine]", 
              RowBox[{"derivPos", "=", 
               RowBox[{"First", "[", "derivPos", "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"beforeDeriv", "=", 
               RowBox[{"Take", "[", 
                RowBox[{"ncList", ",", 
                 RowBox[{"derivPos", "-", "1"}]}], "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"afterDeriv", "=", 
               RowBox[{"Take", "[", 
                RowBox[{"ncList", ",", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"derivPos", "+", "1"}], ",", 
                   RowBox[{"-", "1"}]}], "}"}]}], "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"m", "=", 
               RowBox[{"getPower", "[", 
                RowBox[{"b0", ",", "beforeDeriv"}], "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"A", "=", 
               RowBox[{"getPower", "[", 
                RowBox[{"k", ",", "beforeDeriv"}], "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"n", "=", 
               RowBox[{"getPower", "[", 
                RowBox[{"b0", ",", "afterDeriv"}], "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"B", "=", 
               RowBox[{"getPower", "[", 
                RowBox[{"k", ",", "afterDeriv"}], "]"}]}], ";"}]}], "]"}]}], 
          "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{
            RowBox[{"--", 
             RowBox[{"-", "CONSTRUCT"}]}], " ", "AND", " ", "RETURN", " ", 
            RowBox[{"OUTPUT", "--"}]}], "-"}], "*)"}], 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<SL No.\>\"", "->", "slNo"}], ",", 
           RowBox[{"\"\<Term\>\"", "->", 
            RowBox[{"Short", "[", 
             RowBox[{"term", ",", "5"}], "]"}]}], ",", 
           RowBox[{"\"\<Coeff * F(s, m, n, \[Beta], A, B)\>\"", "->", 
            RowBox[{"coeff", "*", 
             RowBox[{"F", "[", 
              RowBox[{"s", ",", "m", ",", "n", ",", 
               RowBox[{"beta", "/", "2"}], ",", "A", ",", " ", "B"}], 
              "]"}]}]}], ",", 
           
           RowBox[{"\"\<Evaluated Integrals Coeff * F(s, m, n, \[Beta], A, B)\
\>\"", "->", 
            RowBox[{"coeff", "*", 
             RowBox[{"G", "[", 
              RowBox[{"s", ",", "m", ",", "n", ",", 
               RowBox[{"beta", "/", "2"}], ",", "A", ",", " ", "B"}], 
              "]"}]}]}]}], "|>"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"terms", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Head", "[", "expression", "]"}], "===", "Plus"}], ",", 
        RowBox[{"List", "@@", "expression"}], ",", 
        RowBox[{"{", "expression", "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"results", "=", 
      RowBox[{"MapIndexed", "[", 
       RowBox[{"extractPowers", ",", "terms"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Dataset", "[", "results", "]"}]}]}], "]"}]}]], "Input",
