         "d1k", " ", "or", " ", "d2k"}], "*)"}], 
       RowBox[{"pivotPositions", "=", 
        RowBox[{"Position", "[", 
         RowBox[{"elemList", ",", 
          RowBox[{
          "d1k", "|", "d2k", " ", "|", " ", "d11k", " ", "|", " ", "d12k", 
           " ", "|", " ", "d22k"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
