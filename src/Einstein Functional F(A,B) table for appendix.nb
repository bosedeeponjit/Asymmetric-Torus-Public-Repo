Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"SetCommutative", "[", 
    RowBox[{
    "F", ",", "G", ",", "s", ",", "m", ",", "n", ",", "\[Alpha]", ",", 
     "\[Beta]", ",", "A", ",", "B", ",", "U"}], "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"G", "[", 
    RowBox[{
    "s_", ",", "m_", ",", "n_", ",", "\[Beta]_", ",", "A_", ",", "B_"}], 
    "]"}], ":=", 
   RowBox[{"Normal", "[", 
    RowBox[{
     RowBox[{"k", "^", 
      RowBox[{"(", 
       RowBox[{"A", "+", "B", "-", 
        RowBox[{"2", "*", "\[Beta]"}], "-", "1"}], ")"}]}], "*", 
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"U", "^", 
         RowBox[{"(", 
          RowBox[{"2", "*", "\[Beta]"}], ")"}]}], "*", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "/", 
           RowBox[{"(", 
            RowBox[{"1", "+", 
             RowBox[{"U", "^", "2"}]}], ")"}]}], ")"}], "^", "m"}], "*", 
        RowBox[{"s", "^", "B"}], "*", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "/", 
           RowBox[{"(", 
            RowBox[{"1", "+", 
             RowBox[{
              RowBox[{"U", "^", "2"}], "*", 
              RowBox[{"s", "^", "2"}]}]}], ")"}]}], ")"}], "^", "n"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"U", ",", "0", ",", "Infinity"}], "}"}], ",", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"It", "'"}], "s", " ", "still", " ", "good", " ", "to", " ", 
         "put", " ", "assumptions", " ", "here", " ", "to", " ", "help", " ", 
         "the", " ", "integrator", " ", "find", " ", "a", " ", "solution", " ",
          "faster"}], "*)"}], 
       RowBox[{"Assumptions", "->", 
        RowBox[{
         RowBox[{"Re", "[", "s", "]"}], ">=", "0"}]}]}], "]"}]}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.9689451661001816`*^9, 3.9689451758190594`*^9}, {
