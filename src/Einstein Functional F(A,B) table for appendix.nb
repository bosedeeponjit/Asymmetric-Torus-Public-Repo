     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "elemList", ",", "pivotPositions", ",", "lastPivotPosition", ",", 
        "prefix", ",", "suffix"}], "}"}], ",", 
      RowBox[{"(*", 
       RowBox[{
