Cell[BoxData[
 RowBox[{
  RowBox[{"GenerateLatexTable", "[", "dataset_Dataset", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "headerLine1", ",", "headerLine2", ",", "bodyString", ",", "preamble", ",",
       "firstHead", ",", "contHead", ",", "foot", ",", "lastFoot", ",", 
      "tableEnd", ",", "dataRows", ",", "formattedRows", ",", "formatRow", ",",
       "formatElement"}], "}"}], ",", 
    RowBox[{"(*", 
     RowBox[{
     "Helper", " ", "function", " ", "to", " ", "format", " ", "individual", " ",
       "expressions", " ", "for", " ", "LaTeX"}], "*)"}], 
    RowBox[{
     RowBox[{
      RowBox[{"formatElement", "[", "expr_", "]"}], ":=", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", "texString", "}"}], ",", 
        RowBox[{
         RowBox[{"texString", "=", 
          RowBox[{"ToString", "[", 
           RowBox[{"expr", ",", "TeXForm"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
          "Replaces", " ", "the", " ", "first", " ", "space", " ", "after", " ",
            "a", " ", "leading", " ", "numerical", " ", "coefficient", " ", 
           "with", " ", "a", " ", "thin", " ", "space", " ", 
           RowBox[{"(", 
            RowBox[{"\\", ","}], ")"}], " ", "for", " ", "better", " ", 
           "typesetting"}], "*)"}], 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"StringMatchQ", "[", 
            RowBox[{"texString", ",", 
             RowBox[{
             "RegularExpression", 
              "[", "\"\<^\\\\s*-?\\\\d+(\\\\.\\\\d+)?\\\\s+.*\>\"", "]"}]}], 
            "]"}], ",", 
           RowBox[{"texString", "=", 
            RowBox[{"StringReplace", "[", 
             RowBox[{"texString", ",", 
              RowBox[{"\"\< \>\"", "->", "\"\<\\\\, \>\""}], ",", "1"}], 
             "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"\"\<$\>\"", "<>", 
          RowBox[{"StringTrim", "[", "texString", "]"}], 
          "<>", "\"\<$\>\""}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"MODIFICATION", " ", "2"}], ":", 
         RowBox[{
          RowBox[{
           RowBox[{"Reworked", "'"}], 
           RowBox[{"formatRow", "'"}], " ", "to", " ", "handle", " ", "the", " ",
            "4"}], "-", 
          RowBox[{
          "column", " ", "structure", " ", "AND", " ", "center", " ", 
           "content", " ", "in", " ", "columns", " ", "3"}]}]}], "&"}], " ", 
       "4", " ", "using", " ", "parbox", " ", "to", " ", "match", " ", 
       RowBox[{"headers", "."}]}], "*)"}], 
     RowBox[{
      RowBox[{"formatRow", "[", "row_List", "]"}], ":=", 
      RowBox[{"StringRiffle", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"ToString", "[", 
           RowBox[{"First", "[", "row", "]"}], "]"}], ",", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{"Col", " ", "1"}], ":", 
            RowBox[{"SL", " ", "No", " ", 
             RowBox[{"(", 
              RowBox[{"centered", " ", "by", " ", "preamble"}], ")"}]}]}], 
           "*)"}], 
          RowBox[{"formatElement", "[", 
           RowBox[{"row", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "]"}], ",", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{"Col", " ", "2"}], ":", 
            RowBox[{"Terms", " ", 
             RowBox[{"(", 
              RowBox[{"centered", " ", "by", " ", "preamble"}], ")"}]}]}], 
           "*)"}], 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{"Col", " ", "3"}], ":", 
            RowBox[{"F", " ", 
             RowBox[{"(", 
              RowBox[{"centered", " ", "within", " ", "a", " ", "parbox"}], 
              ")"}]}]}], "*)"}], 
          RowBox[{"\"\<\\\\parbox{5cm}{\\centering \>\"", "<>", 
           RowBox[{"formatElement", "[", 
            RowBox[{"row", "[", 
             RowBox[{"[", "3", "]"}], "]"}], "]"}], "<>", "\"\<}\>\""}], ",", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{"Col", " ", "4"}], ":", 
            RowBox[{"G", " ", 
             RowBox[{"(", 
              RowBox[{"centered", " ", "within", " ", "a", " ", "parbox"}], 
              ")"}]}]}], "*)"}], 
          RowBox[{"\"\<\\\\parbox{5cm}{\\centering \>\"", "<>", 
           RowBox[{"formatElement", "[", 
            RowBox[{"row", "[", 
             RowBox[{"[", "4", "]"}], "]"}], "]"}], "<>", "\"\<}\>\""}]}], 
         "}"}], ",", "\"\< & \>\""}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{
        RowBox[{"--", 
         RowBox[{"-", "MODIFIED"}]}], " ", "LATEX", " ", "STRUCTURE", " ", 
        RowBox[{"DEFINITIONS", "--"}]}], "-"}], "*)"}], 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"MODIFICATION", " ", "1"}], ":", 
       RowBox[{
       "Changed", " ", "preamble", " ", "to", " ", "4", " ", "centered", " ", 
        "columns", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"c", "|", "c", "|", "c", "|", "c"}], ")"}], "."}]}]}], 
      "*)"}], 
     RowBox[{"preamble", "=", 
      RowBox[{"\"\<\\\\begin{longtable}{|c|c|c|c|}\\n\>\"", "<>", 
       RowBox[{"(*", 
        RowBox[{"<", 
         RowBox[{
          RowBox[{"--", "CHANGED"}], " ", 
          RowBox[{"{", 
           RowBox[{"c", "|", "l", "|", "l", "|", "l"}], "}"}], " ", "to", " ", 
          RowBox[{"{", 
           RowBox[{"c", "|", "c", "|", "c", "|", "c"}], "}"}]}]}], 
        "*)"}], "\"\<\\\\caption{Analysis of Expression Terms of the form $C \
\\\\,\\\\xi_1^{2\\\\alpha} \\\\xi_2^{2\\\\beta}b_0^m k^A \\\\delta_i(k)b_0^n \
k^B \\\\delta_j(k)$}\\\\label{tab}\\\\\\\\\\n\\\\hline\\n\>\""}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"Headers", " ", "are", " ", "already", " ", "centered"}], ",", 
       RowBox[{"no", " ", "change", " ", "needed"}]}], "*)"}], 
     RowBox[{"headerLine1", "=", 
      RowBox[{
       RowBox[{"StringRiffle", "[", 
        RowBox[{
         RowBox[{"{", 
          
          RowBox[{"\"\<\\\\multicolumn{1}{|c|}{SL No.}\>\"", 
           ",", "\"\<\\\\multicolumn{1}{|c|}{Terms}\>\"", 
           ",", "\"\<\\\\multicolumn{1}{|c|}{\\\\parbox{5cm}{\\\\centering \
$\\\\text{Coeff} \\\\times F(s, m, n,\\\\beta, A, B)$}}\>\"", 
           ",", "\"\<\\\\multicolumn{1}{|c|}{\\\\parbox{5cm}{\\\\centering \
Evaluated Integrals $\\\\text{Coeff} \\\\times F(s, m, n,\\\\beta, A, B)$}}\>\
\""}], "}"}], ",", "\"\< &\\n\>\""}], "]"}], 
       "<>", "\"\< \\\\\\\\\\n\\\\hline\>\""}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"headerLine2", "=", 
      RowBox[{
       RowBox[{"StringRiffle", "[", 
        RowBox[{
         RowBox[{"{", 
          
          RowBox[{"\"\<\\\\multicolumn{1}{|c|}{SL No.}\>\"", 
           ",", "\"\<\\\\multicolumn{1}{|c|}{Terms}\>\"", 
           ",", "\"\<\\\\multicolumn{1}{|c|}{\\\\parbox{5cm}{\\\\centering \
$\\\\text{Coeff} \\\\times F(s, m, n,\\\\beta, A, B)$}}\>\"", 
           ",", "\"\<\\\\multicolumn{1}{|c|}{\\\\parbox{5cm}{\\\\centering \
Evaluated Integrals $\\\\text{Coeff} \\\\times F(s, m, n, \\\\beta, A, \
B)$}}\>\""}], "}"}], ",", "\"\< &\\n\>\""}], "]"}], 
       "<>", "\"\< \\\\\\\\\\n\\\\hline\>\""}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"firstHead", "=", "\"\<\\n\\\\endfirsthead\\n\>\""}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
     "contHead", 
      "=", "\"\<\\\\multicolumn{4}{|c|}{{\\\\bfseries \\\\tablename\\\\ \
\\\\thetable{} -- continued from previous page}} \
\\\\\\\\\\n\\\\hline\\n\>\""}], ";", "\[IndentingNewLine]", 
     RowBox[{"foot", "=", "\"\<\\\\hline\\n\\\\endfoot\\n\>\""}], ";", 
     "\[IndentingNewLine]", 
