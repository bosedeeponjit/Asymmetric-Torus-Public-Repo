            RowBox[{"[", "1", "]"}], "]"}], "==", 
           RowBox[{"Length", "[", "elemList", "]"}]}]}], ",", 
         RowBox[{"Return", "[", "ncm", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
