       "\[IndentingNewLine]", 
       RowBox[{"suffix", "=", 
        RowBox[{"Take", "[", 
         RowBox[{"elemList", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"lastPivotPosition", "+", "1"}], ",", 
            RowBox[{"-", "1"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "6.", " ", "Reassemble", " ", "and", " ", "return", " ", "the", " ", 
         "swapped", " ", "expression"}], "*)"}], 
       RowBox[{"NonCommutativeMultiply", "@@", 
        RowBox[{"Join", "[", 
         RowBox[{"suffix", ",", "prefix"}], "]"}]}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
