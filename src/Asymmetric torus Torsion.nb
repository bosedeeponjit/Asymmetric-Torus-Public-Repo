         ",", 
         RowBox[{
         "or", " ", "the", " ", "pivot", " ", "is", " ", "the", " ", "last", " ",
           "element"}], ",", 
         RowBox[{"return", " ", "unchanged"}]}], "*)"}], 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"pivotPositions", "===", 
           RowBox[{"{", "}"}]}], "||", 
          RowBox[{
           RowBox[{
            RowBox[{"Last", "[", "pivotPositions", "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}], "==", 
           RowBox[{"Length", "[", "elemList", "]"}]}]}], ",", 
         RowBox[{"Return", "[", "ncm", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "4.", " ", "Get", " ", "the", " ", "position", " ", "of", " ", "the", 
         " ", "LAST", " ", "pivot"}], "*)"}], 
       RowBox[{"lastPivotPosition", "=", 
        RowBox[{
         RowBox[{"Last", "[", "pivotPositions", "]"}], "[", 
