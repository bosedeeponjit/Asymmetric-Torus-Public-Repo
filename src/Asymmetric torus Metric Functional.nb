    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "elemList", ",", "pivotPositions", ",", "lastPivotPosition", ",", 
        "prefix", ",", "suffix"}], "}"}], ",", 
      RowBox[{"(*", 
       RowBox[{
       "1.", " ", "Convert", " ", "the", " ", "expression", " ", "into", " ", 
        "a", " ", "list"}], "*)"}], 
      RowBox[{
       RowBox[{"elemList", "=", 
        RowBox[{"List", "@@", "ncm"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "2.", " ", "Find", " ", "the", " ", "positions", " ", "of", " ", 
         "d1k", " ", "or", " ", "d2k"}], "*)"}], 
       RowBox[{"pivotPositions", "=", 
        RowBox[{"Position", "[", 
         RowBox[{"elemList", ",", 
          RowBox[{
          "d1k", "|", "d2k", " ", "|", " ", "d11k", " ", "|", " ", "d12k", 
           " ", "|", " ", "d22k"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
         "3.", " ", "If", " ", "no", " ", "pivot", " ", "is", " ", "found"}], 
         ",", 
         RowBox[{
         "or", " ", "the", " ", "pivot", " ", "is", " ", "the", " ", "last", " ",
           "element"}], ",", 
         RowBox[{"return", " ", "unchanged"}]}], "*)"}], 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"pivotPositions", "===", 
           RowBox[{"{", "}"}]}], "||", 
          RowBox[{
           RowBox[{
            RowBox[{"Last", "[", "pivotPositions", "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}], "==", 
           RowBox[{"Length", "[", "elemList", "]"}]}]}], ",", 
         RowBox[{"Return", "[", "ncm", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "4.", " ", "Get", " ", "the", " ", "position", " ", "of", " ", "the", 
         " ", "LAST", " ", "pivot"}], "*)"}], 
       RowBox[{"lastPivotPosition", "=", 
        RowBox[{
         RowBox[{"Last", "[", "pivotPositions", "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"5.", " ", "Split", " ", "the", " ", "list"}], "*)"}], 
       RowBox[{"prefix", "=", 
        RowBox[{"Take", "[", 
